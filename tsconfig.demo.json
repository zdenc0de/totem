{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["demo/**/*.ts", "src/renderer/**/*", "src/shared/**/*", "src/preload/*.d.ts"],
  "exclude": ["demo/dist", "src/**/*.test.ts"],
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
